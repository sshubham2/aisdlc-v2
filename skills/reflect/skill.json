  "tools": [
    {
      "name": "vault_edit",
      "type": "methodology-tool",
      "invocation": "$PY \"${CLAUDE_SKILL_DIR}/../../scripts/lib/vault_edit.py\" append --file risk-register.json --content-file <tmp>",
      "purpose": "Append new discovered risk entries to risk-register.md (R-32 safe channel, SVW-1/ADR-087)",
      "found": true,
      "path": "scripts/lib/vault_edit.py"
    },
    {
      "name": "build_checks_integrity",
      "type": "methodology-tool",
      "invocation": "$PY \"${CLAUDE_SKILL_DIR}/../../scripts/lib/build_checks_integrity.py\"",
      "purpose": "Post-write integrity gate ensuring build-checks.md matches canonical fixture (BCI-1)",
      "found": true,
      "path": "scripts/lib/build_checks_integrity.py"
    },
    {
      "name": "gate_log",
      "type": "methodology-tool",
      "invocation": "$PY \"${CLAUDE_SKILL_DIR}/../../scripts/lib/gate_log.py\" --kind miss --gate <owning-gate> --slice slice-NNN --severity <sev> --caught-by build|validate|post-ship --ref <note> | $PY \"${CLAUDE_SKILL_DIR}/../../scripts/lib/vault_edit.py\" append --file gate-log.json --array entries --stdin",
      "purpose": "Emit + SVW-1-append one RECALL miss row per MISSED Critic finding (Step 3b; per-gate recall = catches/(catches+misses), measurement spine Phase 0.2 recall half / Theme 8)",
      "found": true,
      "path": "scripts/lib/gate_log.py"
    },
    {
      "name": "code-review-graph",
      "type": "external-package",
      "invocation": "code-review-graph build|update",
      "purpose": "Code graph via code-review-graph (CRG) — builds/refreshes the code graph. Replaces graphify; vault-graph & multimodal-ingest uses dropped.",
      "found": false,
      "note": "External pip package (github.com/tirth8205/code-review-graph), MCP-native; graph stored in .code-review-graph/. Replaces graphify."
    }
  ],
  "harness_tools": [
    {
      "name": "Read",
      "purpose": "Read slice artifacts: mission-brief.json, design.json, critique.json, build-log.json, validation.json, concept.json, risk-register.json, ADRs"
    },
    {
      "name": "Write",
      "purpose": "Create reflection.json; create shippability.json or build-checks.json if they do not yet exist"
    },
    {
      "name": "Edit",
      "purpose": "Update active slice design.json for corrected claims; update build-log.json; update concept.json; mark ADR status:superseded"
    },
    {
      "name": "Glob",
      "purpose": "Find active slice folder and enumerate its artifacts"
    },
    {
      "name": "Bash",
      "purpose": "Run build_checks_integrity"
    }
  ],
