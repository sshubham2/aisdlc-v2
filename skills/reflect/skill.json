{
  "name": "reflect",
  "user_invokable": true,
  "requires_full_context": true,
  "runs_in": "main-agent",
  "context_rationale": "Reflect synthesizes slice artifacts from the current session and interactively gates on user decisions (build-checks promotion), so it depends on main-thread context.",
  "summary": "Captures learnings from the just-completed slice and updates the vault with reality across four categories: validated, corrected, discovered, and deferred. Writes reflection.json, appends to lessons-learned.json and shippability.json, optionally promotes build-checks, and auto-archives the slice. Tracks Critic calibration per TRI-1. Hands off to /commit-slice after completion.",
  "reads": [
    {
      "path": "<vault>/slices/slice-NNN/mission-brief.json",
      "kind": "content-file",
      "produced_by": [
        "slice"
      ],
      "purpose": "Input: slice intent and acceptance criteria"
    },
    {
      "path": "<vault>/slices/slice-NNN/design.json",
      "kind": "content-file",
      "produced_by": [
        "design-slice"
      ],
      "purpose": "Input: design claims to categorize as validated/corrected"
    },
    {
      "path": "<vault>/slices/slice-NNN/critique.json",
      "kind": "content-file",
      "produced_by": [
        "critique"
      ],
      "purpose": "Input: Critic findings to score for calibration"
    },
    {
      "path": "<vault>/slices/slice-NNN/build-log.json",
      "kind": "content-file",
      "produced_by": [
        "build-slice"
      ],
      "purpose": "Input: build deviations"
    },
    {
      "path": "<vault>/slices/slice-NNN/validation.json",
      "kind": "content-file",
